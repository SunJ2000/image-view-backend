# Generate local secrets with: npm run setup:local
NODE_ENV=development
PORT=3000
ADMIN_API_TOKEN=
CORS_ORIGINS=http://localhost:5173
ENABLE_SWAGGER=true
CLEANUP_ENABLED=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=image_view
DB_PASSWORD=
DB_DATABASE=image_view
MYSQL_ROOT_PASSWORD=

# Browser uploads and preview links always use this public endpoint.
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=image-sj
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional: leave blank for signed PUT uploads; set a role ARN for STS multipart/resume.
OSS_STS_ROLE_ARN=
OSS_STS_DURATION_SECONDS=900
UPLOAD_URL_TTL_SECONDS=900
PREVIEW_URL_TTL_SECONDS=3600
MAX_FILE_SIZE_BYTES=5368709120
UPLOAD_SESSION_TTL_SECONDS=86400
